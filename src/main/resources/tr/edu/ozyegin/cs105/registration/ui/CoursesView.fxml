<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tr.edu.ozyegin.cs105.registration.ui.CoursesViewController"
           dividerPositions="0.4">
    <items>
        <TableView fx:id="coursesTable">
            <columns>
                <TableColumn fx:id="codeCol"  text="Code"  prefWidth="100"/>
                <TableColumn fx:id="titleCol" text="Title" prefWidth="220"/>
            </columns>
        </TableView>
        <VBox spacing="8">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label fx:id="courseHeader" text="Select a course" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <Label fx:id="instructorLabel" text="Instructor: -"/>
            <Label fx:id="capacityLabel" text="Capacity: -"/>
            <Label text="Enrolled students:"/>
            <TableView fx:id="rosterTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="rosterNumberCol" text="Number"     prefWidth="110"/>
                    <TableColumn fx:id="rosterFirstCol"  text="First Name" prefWidth="120"/>
                    <TableColumn fx:id="rosterLastCol"   text="Last Name"  prefWidth="140"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <ComboBox fx:id="enrollComboBox" promptText="Pick a student" prefWidth="280"/>
                <Button text="Enroll" onAction="#onEnroll"/>
                <Button text="Drop selected" onAction="#onDrop"/>
            </HBox>
        </VBox>
    </items>
</SplitPane>
